{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webaccessible.app/contracts/skill.schema.json",
  "title": "WebAccessible Canonical Skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_key", "revision", "name", "start_url", "allowed_origins", "source_session_id", "task_outcome", "steps", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_key": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "start_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "pattern": "^https://[^/]+$"}},
    "source_session_id": {"type": "string", "format": "uuid"},
    "task_outcome": {"enum": ["completed", "prepared"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "instruction", "selectors", "preconditions", "expected_transition", "timeout_seconds", "irreversible", "repair_history"],
        "properties": {
          "step_id": {"type": "string", "format": "uuid"},
          "instruction": {"type": "string", "minLength": 1, "maxLength": 240},
          "selectors": {"type": "object"},
          "preconditions": {"type": "array", "maxItems": 5},
          "expected_transition": {"type": "object"},
          "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 120},
          "irreversible": {"type": "boolean"},
          "irreversible_description": {"type": ["string", "null"], "maxLength": 160},
          "amount_source": {"type": ["string", "null"], "maxLength": 96},
          "repair_history": {"type": "array"}
        }
      }
    },
    "provider_skill_id": {"type": ["string", "null"]},
    "provider_case_ids": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
