{
  "name": "webaccessible",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @webaccessible/web dev",
    "build": "pnpm --filter @webaccessible/web build",
    "typecheck": "pnpm --filter @webaccessible/web typecheck",
    "backend": "uv run uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uv run uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"
  }
}

