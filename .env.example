# Development defaults to installed local Chromium and deterministic planning.
# Demo and production require browserbase and snowflake_cortex respectively.
BROWSER_EXECUTION_PROVIDER=local
LOCAL_BROWSER_HEADLESS=true
ACTION_PLANNER_PROVIDER=local

# The API key resolves the Browserbase project; do not add a project ID.
BROWSERBASE_API_KEY=

# EverOS persistent-memory provider.
EVEROS_API_KEY=

# Snowflake service-user connection. Use a scoped programmatic access token,
# never a human password.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=WEBACCESSIBLE_APP
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=WEBACCESSIBLE_APP_ROLE
SNOWFLAKE_WAREHOUSE=WEBACCESSIBLE_WH
SNOWFLAKE_DATABASE=WEBACCESSIBLE
SNOWFLAKE_SCHEMA=APP

# Runtime and hosted participant session configuration.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
SESSION_SIGNING_SECRET=
OPERATIONAL_DATABASE_PATH=data/webaccessible.sqlite3
BUILD_COMMIT=local-development

# The real, harmless build targets. Override only with reviewed HTTPS origins.
DEMO_TARGET_NAME=Choose lettuce and tomato
DEMO_TARGET_URL=https://www.w3.org/WAI/ARIA/apg/patterns/checkbox/examples/checkbox/
DEMO_FALLBACK_URL=https://www.w3.org/WAI/ARIA/apg/patterns/radio/examples/radio/
GUIDANCE_MODEL=claude-haiku-4-5
GUIDANCE_MODEL_PROVIDER=snowflake_cortex
GUIDANCE_MODEL_RATE_CARD_VERSION=snowflake-cortex-any-region-2026-08-07

# Optional hosted caregiver delivery. Unset means persisted pending delivery.
ESCALATION_WEBHOOK_URL=

# Leave empty for same-origin production. Set only for split local development.
VITE_API_BASE_URL=
